# Copy to .env.local. `supabase start` prints the first three values.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS and signs Storage URLs — never prefix with
# NEXT_PUBLIC_. On Vercel, set it for Production and Preview only.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string, e.g. `openssl rand -hex 32`. Salts the per-visitor
# hash used for attribution and anonymous rate limiting, so no raw IP is
# stored. Rotating it just resets every rate-limit bucket.
EDIT_ACTOR_SALT=

# Origin that sign-up, magic-link, reset and Google sign-in links point back to.
# Defaults to https://silaturahmi.jadigampang.com; set it for local dev.
SITE_URL=http://localhost:3000
